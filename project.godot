; Engine configuration file.
; Protocol Zero - tactical idle taskbar RPG
config_version=5

[application]

config/name="Protocol Zero"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[dotnet]

project/assembly_name="ProtocolZero"

[autoload]

Balance="*res://src/autoload/Balance.cs"
GameState="*res://src/autoload/GameState.cs"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.11, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
